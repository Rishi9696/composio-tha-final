# Copy to .env and fill in. NEVER commit .env.

# --- Official paid provider: OpenAI (synthesis + web search) ---
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4.1
# Lighter model used only for the web-search discovery step.
OPENAI_SEARCH_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=180
OPENAI_MAX_WORKERS=2

# Hard per-run safety cap. out/usage.json records estimated spend.
OPENAI_RUN_BUDGET_USD=10
SEARCH_CACHE_DAYS=7

# --- Composio (authoritative SDK audit + read-only Session agent) ---
COMPOSIO_API_KEY=replace_me

# --- Optional: independent Browser Use Cloud verification ---
# BROWSER_USE_API_KEY=replace_me

# The Session agent reuses OPENAI_MODEL above. It enables only Composio's no-auth
# browser_tool and never receives vendor credentials.
